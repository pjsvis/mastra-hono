# API Keys
GROQ_API_KEY=your-api-key

# Ollama Configuration
# Base URL for Ollama API (default: http://localhost:11434/api)
OLLAMA_BASE_URL=http://localhost:11434/api

# Model for complex reasoning tasks (default: lfm2.5-thinking)
OLLAMA_THINKING_MODEL=lfm2.5-thinking

# Model for fast responses (default: llama3.2)
OLLAMA_FAST_MODEL=llama3.2

# Model for embeddings (default: nomic-embed-text)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Model for memory agent (default: qwen3.5:latest)
OLLAMA_MEMORY_MODEL=qwen3.5:latest
