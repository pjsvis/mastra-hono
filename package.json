{
  "name": "mastra-hono",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "cli": "bun run src/cli/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist coverage .mastra",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "lint:ox": "oxlint",
    "lint:ox:fix": "oxlint --fix",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "check": "biome check && oxlint && tsc --noEmit",
    "precommit": "bun run lint && bun run typecheck",
    "verify": "bun run check && bun run test",
    "finish": "bash scripts/finish.sh",
    "ask": "bash scripts/ask.sh",
    "status": "bun cli task status",
    "tdl": "bun cli task list",
    "tdu": "bun cli task usage",
    "td-open": "bun cli task open",
    "td-review": "bun cli task review",
    "td-worktree": "bash scripts/td-worktree.sh",
    "pb": "bash scripts/pb.sh",
    "pb:index": "bun run scripts/pb-index.ts",
    "create-pr": "bash scripts/create-pr.sh",
    "cleanup-stale-tasks": "bash scripts/cleanup-stale-tasks.sh",
    "env:setup": "bash scripts/setup-mastra-env.sh",
    "env:export": "bash scripts/export-mastra-env.sh"
  },
  "dependencies": {
    "@docmd/core": "^0.6.3",
    "@docmd/plugin-llms": "^0.6.3",
    "@mastra/core": "^1.4.0",
    "@mastra/hono": "^1.1.3",
    "@mastra/libsql": "^1.4.0",
    "@mastra/loggers": "^1.0.1",
    "@mastra/mcp": "^1.0.2",
    "@mastra/memory": "^1.3.0",
    "@mastra/observability": "^1.2.0",
    "citty": "^0.2.1",
    "hono": "^4.11.9",
    "just-bash": "^2.10.2",
    "mastra": "^1.3.1",
    "ollama-ai-provider-v2": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@types/bun": "^1.2.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.8.3"
  }
}
